@model EvoDentalClinic.PL.ViewModels.IncomeReportViewModel
@{
    ViewData["Title"] = "تقرير الإيراد";
    var r = Model.Report;
}

<ul class="nav nav-tabs mb-4">
    <li class="nav-item"><a class="nav-link active" asp-action="Income">الإيراد</a></li>
    <li class="nav-item"><a class="nav-link" asp-action="Outstanding">المتبقي على المرضى</a></li>
</ul>

<h2 class="mb-3">تقرير الإيراد</h2>

<form method="get" asp-action="Income" class="row g-2 mb-2">
    <div class="col-md-3">
        <label class="form-label">من</label>
        <input type="date" name="fromDate" value="@Model.From.ToIso()" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">إلى</label>
        <input type="date" name="toDate" value="@Model.To.ToIso()" class="form-control" />
    </div>
    <div class="col-auto d-flex align-items-end">
        <button type="submit" class="btn btn-secondary">عرض</button>
    </div>
</form>

<div class="mb-4">
    <a asp-action="Income" asp-route-fromDate="@Model.Today.ToIso()" asp-route-toDate="@Model.Today.ToIso()"
       class="btn btn-outline-secondary btn-sm">النهاردة</a>
    <a asp-action="Income" asp-route-fromDate="@Model.MonthStart.ToIso()" asp-route-toDate="@Model.Today.ToIso()"
       class="btn btn-outline-secondary btn-sm">الشهر ده</a>
    <a asp-action="Income" asp-route-fromDate="@Model.PrevMonthStart.ToIso()" asp-route-toDate="@Model.PrevMonthEnd.ToIso()"
       class="btn btn-outline-secondary btn-sm">الشهر اللي فات</a>
</div>

@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}
else if (r is not null)
{
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card text-center">
                <div class="card-body">
                    <div class="text-muted small">إجمالي الإيراد</div>
                    <div class="fs-3 fw-bold text-success">@r.Total.ToMoney()</div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card text-center">
                <div class="card-body">
                    <div class="text-muted small">عدد الدفعات</div>
                    <div class="fs-3 fw-bold">@r.PaymentsCount</div>
                </div>
            </div>
        </div>
    </div>

    <h5 class="mb-2">الحجوزات في الفترة دي</h5>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <div class="text-muted small">تم الكشف</div>
                    <div class="fs-4 fw-bold text-success">@r.CompletedCount</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <div class="text-muted small">لم يحضر</div>
                    <div class="fs-4 fw-bold text-warning">@r.NoShowCount</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <div class="text-muted small">ملغي</div>
                    <div class="fs-4 fw-bold text-secondary">@r.CancelledCount</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <div class="text-muted small">لسه محجوز</div>
                    <div class="fs-4 fw-bold text-primary">@r.BookedCount</div>
                </div>
            </div>
        </div>
    </div>

    <h5 class="mb-2">الإيراد يوم بيوم</h5>

    @if (!r.Days.Any())
    {
        <div class="alert alert-light border">مفيش دفعات اتسجلت في الفترة دي.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle bg-white">
                <thead>
                    <tr>
                        <th>اليوم</th>
                        <th>عدد الدفعات</th>
                        <th>الإيراد</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in r.Days)
                    {
                        <tr>
                            <td>@d.Date.ToArabicDate()</td>
                            <td>@d.Count</td>
                            <td>@d.Amount.ToMoney()</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td>الإجمالي</td>
                        <td>@r.PaymentsCount</td>
                        <td>@r.Total.ToMoney()</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }

    <p class="text-muted small">الإيراد هو مجموع الدفعات اللي اتسجلت في الفترة، مش تكلفة الإجراءات. التواريخ بتوقيت القاهرة.</p>
}