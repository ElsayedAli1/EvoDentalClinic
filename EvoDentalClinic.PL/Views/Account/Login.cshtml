@model EvoDentalClinic.PL.ViewModels.LoginViewModel
@inject Microsoft.Extensions.Options.IOptions<EvoDentalClinic.PL.Config.ClinicInfoOptions> Clinic
@{
    ViewData["Title"] = "تسجيل الدخول";
    var c = Clinic.Value;
}

<div class="auth-card">
    <img src="~/images/branding/logo.png" alt="" class="auth-logo" onerror="this.remove()" />
    <h2 class="auth-title">تسجيل الدخول</h2>
    <p class="auth-sub">@c.Name</p>

    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Identifier" class="form-label"></label>
            <input asp-for="Identifier" class="form-control ltr-input" autocomplete="username" />
            <span asp-validation-for="Identifier" class="text-danger"></span>
        </div>

        <div class="mb-2">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control ltr-input" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input type="checkbox" class="form-check-input" id="showPw" data-toggle-password="#Password" />
            <label class="form-check-label" for="showPw">إظهار كلمة المرور</label>
        </div>

        <div class="form-check mb-4">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-primary w-100 btn-shine">دخول</button>
    </form>

    <p class="text-center text-muted small mt-4 mb-1">
        نسيت كلمة المرور؟ كلّم العيادة على
        <a href="tel:@c.Phone" dir="ltr">@c.Phone</a> وهنغيّرها لك.
    </p>
    <p class="text-center mb-0">
        ليس لديك حساب؟ <a asp-action="Register">إنشاء حساب</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}