@model EvoDentalClinic.PL.ViewModels.PaymentPageViewModel
@using System.Globalization
@{
    ViewData["Title"] = "دفعات الإجراء";
    var t = Model.Treatment;
}

<h2 class="mb-1">دفعات الإجراء</h2>
<p class="text-muted">المريض: <strong>@Model.PatientName</strong></p>

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="text-muted small">الإجراء</div>
                <div>@t.Procedure (سن @t.ToothNumber)</div>
            </div>
            <div class="col-md-2">
                <div class="text-muted small">التاريخ</div>
                <div>@t.Date.ToString("dd/MM/yyyy")</div>
            </div>
            <div class="col-md-2">
                <div class="text-muted small">التكلفة</div>
                <div class="fw-bold">@t.TotalCost.ToMoney()</div>
            </div>
            <div class="col-md-2">
                <div class="text-muted small">المدفوع</div>
                <div class="fw-bold text-success">@t.TotalPaid.ToMoney()</div>
            </div>
            <div class="col-md-2">
                <div class="text-muted small">المتبقي</div>
                <div class="fw-bold @(t.Balance > 0 ? "text-danger" : "")">@t.Balance.ToMoney()</div>
            </div>
        </div>
    </div>
</div>

@if (t.Balance > 0)
{
    <form asp-action="Create" method="post" id="payment-form" class="mb-4">
        <input type="hidden" name="treatmentId" value="@t.Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Input.Amount" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Input.Amount" type="number" step="0.01" min="0.01" class="form-control" />
                    <button type="button" class="btn btn-outline-secondary" id="fill-balance"
                            data-balance="@t.Balance.ToString("0.##", CultureInfo.InvariantCulture)">
                        المتبقي كله
                    </button>
                </div>
                <span asp-validation-for="Input.Amount" class="text-danger"></span>
            </div>

            <div class="col-md-8">
                <label asp-for="Input.Note" class="form-label"></label>
                <input asp-for="Input.Note" class="form-control" placeholder="اختياري" />
                <span asp-validation-for="Input.Note" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-success">تسجيل الدفعة</button>
            <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId"
               class="btn btn-link">رجوع</a>
        </div>
    </form>
}
else
{
    <div class="alert alert-success">الإجراء ده مسدد بالكامل.</div>
}

<h5 class="mb-2">الدفعات السابقة</h5>

@if (!Model.History.Any())
{
    <div class="alert alert-light border">لسه ما اتسجلتش أي دفعة.</div>
}
else
{
    <div class="table-responsive mb-3">
        <table class="table align-middle bg-white">
            <thead>
                <tr>
                    <th>التاريخ والوقت</th>
                    <th>المبلغ</th>
                    <th>ملاحظة</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.History)
                {
                    <tr>
                        <td>@p.PaidAt.ToCairoDateTime()</td>
                        <td>@p.Amount.ToMoney()</td>
                        <td>@p.Note</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (t.Balance <= 0)
{
    <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId"
       class="btn btn-link">رجوع لملف المريض</a>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // زر "المتبقي كله" بيملا الخانة بالمبلغ
        var fill = document.getElementById('fill-balance');
        if (fill) {
            fill.addEventListener('click', function () {
                document.getElementById('Input_Amount').value = fill.dataset.balance;
            });
        }

        // منع الضغط المزدوج: في الفلوس، دفعتين بالغلط مشكلة
        $('#payment-form').on('submit', function () {
            if ($(this).valid()) {
                $(this).find('button[type=submit]').prop('disabled', true);
            }
        });
    </script>
}