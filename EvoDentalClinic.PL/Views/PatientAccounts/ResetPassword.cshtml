@model EvoDentalClinic.PL.ViewModels.ResetPatientPasswordViewModel
@{
    ViewData["Title"] = "تغيير كلمة مرور المريض";
}

<h2 class="mb-1">تغيير كلمة مرور المريض</h2>
<p class="text-muted">المريض: <strong>@Model.PatientName</strong></p>

<form asp-action="ResetPassword" method="post">
    <input type="hidden" asp-for="PatientId" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">حفظ</button>
        <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId"
           class="btn btn-link">رجوع</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}