@model EvoDentalClinic.PL.ViewModels.ClinicSettingsFormViewModel
@using System.Globalization
@{
    ViewData["Title"] = "إعدادات العيادة";
    var days = new[]
    {
        DayOfWeek.Saturday, DayOfWeek.Sunday, DayOfWeek.Monday, DayOfWeek.Tuesday,
        DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday
    };
    var slotOptions = new[] { 10, 15, 20, 30, 45, 60 };
    var perDay = ViewData["SlotsPerDay"] as int?;
}

<h2 class="mb-1">إعدادات العيادة</h2>
<p class="text-muted">
    الإعدادات دي هي اللي بتتحكم في مواعيد الحجز المتاحة، وبتظهر في الصفحة العامة للعيادة.
    @if (perDay is not null)
    {
        <span>الإعدادات الحالية بتطلّع <strong>@perDay</strong> ميعاد في اليوم.</span>
    }
</p>

<form asp-action="Index" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card mb-3">
        <div class="card-header">أيام الشغل</div>
        <div class="card-body d-flex flex-wrap gap-3">
            @foreach (var day in days)
            {
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="day-@day" name="WorkDays" value="@day"
                    @(Model.WorkDays.Contains(day) ? "checked" : "") />
                    <label class="form-check-label" for="day-@day">@day.ToArabic()</label>
                </div>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">ساعات الشغل ومدة الكشف</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label for="OpenTime" class="form-label">بداية الشغل</label>
                    <input type="time" name="OpenTime" id="OpenTime" class="form-control"
                           value="@(Model.OpenTime?.ToString("HH:mm", CultureInfo.InvariantCulture))" />
                    <span asp-validation-for="OpenTime" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label for="CloseTime" class="form-label">نهاية الشغل</label>
                    <input type="time" name="CloseTime" id="CloseTime" class="form-control"
                           value="@(Model.CloseTime?.ToString("HH:mm", CultureInfo.InvariantCulture))" />
                    <span asp-validation-for="CloseTime" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="SlotMinutes" class="form-label"></label>
                    <select asp-for="SlotMinutes" class="form-select">
                        @foreach (var m in slotOptions)
                        {
                            <option value="@m">@m دقيقة</option>
                        }
                    </select>
                    <span asp-validation-for="SlotMinutes" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">حفظ الإعدادات</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}