@model EvoDentalClinic.PL.ViewModels.TreatmentFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="Date" class="form-label"></label>
        <input asp-for="Date" class="form-control" />
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="ToothNumber" class="form-label"></label>
        <input asp-for="ToothNumber" type="number" class="form-control" />
        <div class="form-text">نظام FDI: الدائمة من 11 لـ 48، واللبنية من 51 لـ 85</div>
        <span asp-validation-for="ToothNumber" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="TotalCost" class="form-label"></label>
        <input asp-for="TotalCost" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="TotalCost" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Procedure" class="form-label"></label>
        <input asp-for="Procedure" class="form-control" placeholder="مثال: حشو عصب، خلع، تنظيف" />
        <span asp-validation-for="Procedure" class="text-danger"></span>
    </div>
</div>