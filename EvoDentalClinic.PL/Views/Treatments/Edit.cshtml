@model EvoDentalClinic.PL.ViewModels.TreatmentFormViewModel
@{
    ViewData["Title"] = "تعديل إجراء علاجي";
}

<h2 class="mb-1">تعديل إجراء علاجي</h2>
<p class="text-muted">المريض: <strong>@Model.PatientName</strong></p>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <partial name="_TreatmentForm" model="Model" />

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">حفظ التعديلات</button>
        <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId"
           class="btn btn-link">رجوع</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}