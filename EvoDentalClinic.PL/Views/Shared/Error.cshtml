@model ErrorViewModel
@{
    ViewData["Title"] = "حصل خطأ";
}

<div class="text-center py-5">
    <h1 class="fw-bold">حصل خطأ غير متوقع</h1>
    <p class="text-muted">
        حاول تاني بعد شوية. ولو المشكلة فضلت، كلّم المسؤول عن النظام.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">
            رقم الطلب: <code dir="ltr">@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">الرجوع للرئيسية</a>
</div>