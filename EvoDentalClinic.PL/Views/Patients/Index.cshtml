@model EvoDentalClinic.BLL.Common.PagedResult<EvoDentalClinic.BLL.DTOs.PatientDto.PatientDto>
@{
    ViewData["Title"] = "المرضى";
    var term = ViewData["Term"] as string;
}

<div class="page-head">
    <div>
        <h2>المرضى</h2>
        <p class="page-sub">ابحث بالاسم أو رقم الموبايل أو كود الملف.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-shine">+ إضافة مريض</a>
</div>

<form method="get" class="search-card mb-4">
    <div class="row g-2 align-items-center">
        <div class="col">
            <input type="search" name="term" value="@term" class="form-control"
                   placeholder="مثال: أحمد، 0101، P-00012" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">بحث</button>
            @if (!string.IsNullOrWhiteSpace(term))
            {
                <a asp-action="Index" class="btn btn-link">عرض الكل</a>
            }
        </div>
    </div>
</form>

@if (!Model.Items.Any())
{
    <div class="alert alert-light border">
        @if (string.IsNullOrWhiteSpace(term))
        {
            <span>لسه مفيش مرضى مسجلين.</span>
        }
        else
        {
            <span>مفيش نتايج للبحث. تقدر <a asp-action="Create">تضيف مريض جديد</a>.</span>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>المريض</th>
                    <th>الموبايل</th>
                    <th class="d-none d-md-table-cell">السن</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Items)
                {
                    var initial = string.IsNullOrWhiteSpace(p.FullName) ? "؟" : p.FullName.Trim()[0].ToString();

                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar">@initial</span>
                                <div>
                                    <a asp-action="Details" asp-route-id="@p.Id"
                                       class="fw-bold text-decoration-none">@p.FullName</a>
                                    <div class="text-muted small">@p.Code</div>
                                </div>
                            </div>
                        </td>
                        <td dir="ltr" class="text-end">@p.Phone</td>
                        <td class="d-none d-md-table-cell">@(p.Age?.ToString() ?? "-")</td>
                        <td>
                            <div class="d-flex flex-wrap justify-content-end gap-1">
                                <a asp-controller="Appointments" asp-action="Book" asp-route-patientId="@p.Id"
                                   class="btn btn-primary btn-sm">حجز</a>
                                <a asp-action="Details" asp-route-id="@p.Id"
                                   class="btn btn-outline-primary btn-sm">الملف</a>
                                <a asp-controller="MedicalHistory" asp-action="Details" asp-route-patientId="@p.Id"
                                   class="btn btn-outline-secondary btn-sm">التاريخ المرضي</a>
                                <a asp-action="Edit" asp-route-id="@p.Id"
                                   class="btn btn-outline-secondary btn-sm">تعديل</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="text-muted small mt-2 mb-2">إجمالي النتايج: @Model.TotalCount</p>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="الصفحات">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-term="@term"
                       asp-route-page="@(Model.Page - 1)">السابق</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">صفحة @Model.Page من @Model.TotalPages</span>
                </li>
                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-term="@term"
                       asp-route-page="@(Model.Page + 1)">التالي</a>
                </li>
            </ul>
        </nav>
    }
}